# Supabase project (Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # service_role key — server only, never expose to the client

# BFF auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
PIN_PEPPER=change-me

# External Read API (/api/v1/*) token hashing — see docs/PRD-external-api.md.
# Deliberately a separate secret from PIN_PEPPER: rotating one must never
# invalidate the other kind of credential.
API_TOKEN_PEPPER=change-me

# Set by Vercel automatically in production; only needed for local dev cookie behavior
NODE_ENV=development
